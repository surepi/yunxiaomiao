GATEWAY_PORT=8080
GATEWAY_HOST=127.0.0.1
CORS_ORIGIN=https://portal.example.com

# CHANGE ALL SECRETS BELOW (use long random strings)
JWT_USER_SECRET=change-me-user-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_EXPIRES_IN=7d
WEBHOOK_SECRET=change-me-webhook-secret

# Gateway admin console account (created on first boot / seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Admin123

# Panel runs locally on the cloud server (official MCSM install, port 23333)
PANEL_BASE_URL=http://127.0.0.1:23333
# Dedicated ADMIN service account apiKey from the MCSM panel (enableApiKey=ONLY_ADMIN)
PANEL_API_KEY=replace-with-panel-admin-apikey
# Public panel domain (used to build one-click SSO login links)
MCSM_UI_ORIGIN=https://panel.example.com

# Default: SQLite (single file, zero extra service). For native MySQL see README.
DATABASE_URL=file:/opt/mcsm-shop/gateway/data/gateway.db
RECONCILE_INTERVAL_MINUTES=60
