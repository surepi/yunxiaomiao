# HTTP server
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5174

# Auth secrets (change in production)
JWT_USER_SECRET=change-me-user-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_EXPIRES_IN=7d

# Default admin console account (used by the seed script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# MCSManager panel
# Server-to-server API address (can stay on the internal network)
PANEL_BASE_URL=http://localhost:23333
# Dedicated ADMIN service account apiKey (enable ONLY_ADMIN apiKey mode in the panel)
PANEL_API_KEY=replace-with-panel-admin-apikey
# User-facing address of the MCSM UI (used to build one-click SSO login links)
MCSM_UI_ORIGIN=http://localhost:23333

# Database (SQLite by default for zero-infra local run; switch to MySQL/Postgres in production)
DATABASE_URL="file:./data/gateway.db"

# Reconcile interval (minutes)
RECONCILE_INTERVAL_MINUTES=60
