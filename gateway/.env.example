# HTTP server
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5174

# Auth secrets (change in production)
JWT_USER_SECRET=change-me-user-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_EXPIRES_IN=7d

# Default admin console account (used by the seed script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# MCSManager panel
# Server-to-server API address (can stay on the internal network)
PANEL_BASE_URL=http://localhost:23333
# Dedicated ADMIN service account apiKey (enable ONLY_ADMIN apiKey mode in the panel)
PANEL_API_KEY=replace-with-panel-admin-apikey
# User-facing address of the MCSM UI (used to build one-click SSO login links)
MCSM_UI_ORIGIN=http://localhost:23333

# Database (SQLite by default for zero-infra local run; switch to MySQL/Postgres in production)
DATABASE_URL="file:./data/gateway.db"

# Reconcile interval (minutes)
RECONCILE_INTERVAL_MINUTES=60

# Panel usernames blocked from buyer portal login/registration (comma
# separated). The MCSM super admin "root" must never be a buyer account;
# panel accounts with permission>=10 are rejected even if not listed.
BUYER_RESERVED_USERNAMES=root

# Brute-force login protection (per account, on top of per-IP rate limiting).
# After this many consecutive failed logins the account is temporarily locked.
LOGIN_MAX_FAILURES=5
# Lockout duration in minutes.
LOGIN_LOCKOUT_MINUTES=15

# Expired-instance lifecycle
# Days after expiry before cleanup (buyers can still renew to recover data).
GRACE_PERIOD_DAYS=7
# Opt-in: actually delete expired instances after the grace period.
# Leave false to only email warnings and keep servers stopped in place.
AUTO_DELETE_EXPIRED=false
# When auto-deleting, also wipe the daemon game files (default keeps them as a
# manual recovery safety net).
DELETE_INSTANCE_FILES=false
# Where pre-deletion metadata snapshots are written.
BACKUP_DIR=data/backups

# Buyer portal origin (used to build password-reset links in emails)
PORTAL_ORIGIN=http://localhost:5174

# Outbound email (SMTP). Disabled by default; provision/renew/expiry/reset
# emails are skipped (only logged) until enabled and configured.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=云小喵 <no-reply@example.com>

# Shared secret verifying inbound sales-channel webhooks (taobao/ERP)
WEBHOOK_SECRET=change-me-webhook-secret

# Ops alerts (node offline/recovery, panel API unreachable, failed orders).
# Comma-separated recipient list; leave empty to only log alerts.
ALERT_EMAIL=
# Health sweep interval in minutes.
ALERT_INTERVAL_MINUTES=10
